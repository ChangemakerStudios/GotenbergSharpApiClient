<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Native AOT smoke test. Publish it and run the resulting binary:

		  dotnet publish test/GotenbergSharpClient.AotSmokeTest -c Release -r <rid>
		  test/GotenbergSharpClient.AotSmokeTest/bin/Release/net10.0/<rid>/publish/GotenbergSharpClient.AotSmokeTest

		The publish fails on any trim/AOT warning from the client or its dependencies;
		the binary exits non-zero when a check fails at runtime.
	-->

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<PublishAot>true</PublishAot>
		<InvariantGlobalization>true</InvariantGlobalization>
		<!-- One warning per call site instead of one per assembly, so dependencies are itemised. -->
		<TrimmerSingleWarn>false</TrimmerSingleWarn>
		<IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Gotenberg.Sharp.Api.Client\Gotenberg.Sharp.Api.Client.csproj" />
		<!--
			By default the client is trimmed like it would be in a consumer's app, so the checks catch members
			the trimmer wrongly removes. Pass -p:RootClientAssembly=true to keep and analyse the whole client
			instead, which lists warnings for code Program.cs does not reach.
		-->
		<TrimmerRootAssembly Include="Gotenberg.Sharp.API.Client" Condition="'$(RootClientAssembly)' == 'true'" />
	</ItemGroup>

</Project>

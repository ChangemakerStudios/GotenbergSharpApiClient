{
  "metadata": [
    {
      "src": [
        {
          "files": ["**/*.csproj"],
          "src": "../src"
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net8.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": ["api/**/*.yml", "api/index.md"]
      },
      {
        "files": [
          "articles/**/*.md",
          "articles/**/toc.yml",
          "toc.yml",
          "*.md"
        ]
      }
    ],
    "resource": [
      {
        "files": ["images/**"]
      }
    ],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appTitle": "GotenbergSharpApiClient",
      "_appName": "GotenbergSharpApiClient",
      "_appFooter": "GotenbergSharpApiClient - C# Client for Gotenberg API",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/ChangemakerStudios/GotenbergSharpApiClient",
        "branch": "develop"
      }
    }
  }
}
